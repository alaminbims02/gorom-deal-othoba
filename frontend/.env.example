# ---- WordPress / WooCommerce (শুধু সার্ভার; কখনো NEXT_PUBLIC_ দেবেন না) ----
WC_URL=https://your-wordpress-site.com
# WooCommerce → Settings → Advanced → REST API → Read-only key
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- ফ্রন্টএন্ড ----
# সাইটের পাবলিক URL (sitemap, canonical, JSON-LD)
SITE_URL=https://your-store.vercel.app
# অতিরিক্ত ইমেজ হোস্ট (কমা দিয়ে)। WC_URL-এর হোস্ট স্বয়ংক্রিয়ভাবে অনুমোদিত।
WP_IMAGE_HOSTS=
# লোকাল WP-তে ইমেজ অপটিমাইজার বন্ধ করতে 1
WP_IMAGE_UNOPTIMIZED=

# ---- সিকিউরিটি ----
# WP প্লাগিনের revalidate webhook এই সিক্রেট পাঠায় (প্লাগিন → ফ্রন্টএন্ড কানেকশন-এর সাথে একই)
REVALIDATE_SECRET=change-me-long-random
# Next /api → WP প্লাগিন প্রক্সি কী (প্লাগিনের "Proxy secret"-এর সাথে একই); ক্লায়েন্টের আসল IP ফরোয়ার্ড করতে
GD_PROXY_SECRET=change-me-another-long-random
